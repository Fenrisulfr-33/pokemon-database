{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://pokemon-database.com/schemas/pokemon.json",
    "title": "Pokemon",
    "description": "Schema for one entry in src/pokemon/pokedex/entries. `moves` and `gameDropDown` are added at upsert time (see pokedex/upsert.js and pokedex/helpers.js) and are not present in the source entry files, so both are optional here to cover the document at either stage.",
    "type": "object",
    "required": [
        "_id",
        "key",
        "name",
        "type",
        "abilities",
        "baseStats",
        "info",
        "gender",
        "evolution",
        "evs",
        "eggGroups",
        "species",
        "catchRate",
        "baseFriendship",
        "growthRate",
        "eggCycles",
        "nameOrigin",
        "pokedexEntries"
    ],
    "additionalProperties": false,
    "definitions": {
        "type": {
            "type": "string",
            "enum": ["normal", "fire", "water", "electric", "grass", "ice", "fighting", "poison", "ground", "flying", "psychic", "bug", "rock", "ghost", "dragon", "dark", "steel", "fairy"]
        },
        "genderPercent": {
            "description": "Percent chance, e.g. 87.5; null when unknown or genderless",
            "oneOf": [
                { "type": "number", "minimum": 0, "maximum": 100 },
                { "type": "null" }
            ]
        },
        "abilityId": {
            "type": "integer",
            "minimum": 1,
            "description": "References abilities entry _id"
        }
    },
    "properties": {
        "_id": {
            "type": "number",
            "minimum": 1,
            "description": "Pokedex id; alternate forms use a decimal suffix, e.g. 6.1 for Mega Charizard X (matches the id convention in evolutions/EVOLUTIONS.md)"
        },
        "key": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "URL-safe key identifier"
        },
        "name": {
            "type": "object",
            "required": ["english"],
            "additionalProperties": false,
            "properties": {
                "english": { "type": "string", "minLength": 1 },
                "spanish": { "type": "string" },
                "italian": { "type": "string" },
                "japanese": { "type": "string" },
                "chinese": { "type": "string" },
                "korean": { "type": "string" },
                "german": { "type": "string" },
                "french": { "type": "string" }
            }
        },
        "pokedexNumber": {
            "type": "object",
            "description": "Per-game national/regional dex numbers. Not present in the source entry file - computed fresh at upsert time by pokedex/AssignPokedexNumbers.js from dexes/dexes_objects/*.json, so it isn't hand-maintained here.",
            "additionalProperties": false,
            "patternProperties": {
                "^[a-z0-9-]+$": { "type": "integer", "minimum": 1 }
            }
        },
        "type": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "description": "Lowercase types in slot order",
            "items": { "$ref": "#/definitions/type" }
        },
        "abilities": {
            "type": "object",
            "required": ["normal", "hidden"],
            "additionalProperties": false,
            "properties": {
                "normal": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 2,
                    "uniqueItems": true,
                    "description": "Normal ability ids in slot order",
                    "items": { "$ref": "#/definitions/abilityId" }
                },
                "hidden": {
                    "description": "Hidden ability id, or null if the pokemon has none",
                    "oneOf": [
                        { "$ref": "#/definitions/abilityId" },
                        { "type": "null" }
                    ]
                }
            }
        },
        "baseStats": {
            "type": "object",
            "required": ["hp", "atk", "def", "spatk", "spdef", "spd", "total"],
            "additionalProperties": false,
            "properties": {
                "hp": { "type": "integer", "minimum": 1, "maximum": 255 },
                "atk": { "type": "integer", "minimum": 1, "maximum": 255 },
                "def": { "type": "integer", "minimum": 1, "maximum": 255 },
                "spatk": { "type": "integer", "minimum": 1, "maximum": 255 },
                "spdef": { "type": "integer", "minimum": 1, "maximum": 255 },
                "spd": { "type": "integer", "minimum": 1, "maximum": 255 },
                "total": { "type": "integer", "minimum": 6, "maximum": 1530 }
            }
        },
        "info": {
            "type": "object",
            "required": ["height", "weight"],
            "additionalProperties": false,
            "properties": {
                "height": { "type": "integer", "minimum": 1, "description": "Decimeters, from PokeAPI" },
                "weight": { "type": "integer", "minimum": 1, "description": "Hectograms, from PokeAPI" }
            }
        },
        "gender": {
            "type": "object",
            "required": ["male", "female", "genderless"],
            "additionalProperties": false,
            "properties": {
                "male": { "$ref": "#/definitions/genderPercent" },
                "female": { "$ref": "#/definitions/genderPercent" },
                "genderless": { "type": "boolean" }
            }
        },
        "evolution": {
            "type": ["number", "null"],
            "description": "References the _id of this pokemon's chain in src/pokemon/evolutions/entries; forms not in a chain use their base pokemon's chain (Math.floor(_id)); null when in no chain"
        },
        "evs": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "hp": { "type": "integer", "minimum": 0, "maximum": 3 },
                "atk": { "type": "integer", "minimum": 0, "maximum": 3 },
                "def": { "type": "integer", "minimum": 0, "maximum": 3 },
                "spatk": { "type": "integer", "minimum": 0, "maximum": 3 },
                "spdef": { "type": "integer", "minimum": 0, "maximum": 3 },
                "spd": { "type": "integer", "minimum": 0, "maximum": 3 }
            }
        },
        "eggGroups": {
            "type": "array",
            "description": "Empty or containing null for newer entries whose egg group data hasn't been filled in yet",
            "items": {
                "type": ["string", "null"],
                "enum": ["Amorphous", "Bug", "Ditto", "Dragon", "Fairy", "Field", "Flying", "Grass", "Human-Like", "Mineral", "Monster", "Undiscovered", "Water 1", "Water 2", "Water 3", null]
            }
        },
        "species": {
            "type": "string",
            "description": "e.g. \"Seed Pokémon\"; empty string for a small number of recently-added entries pending data collection"
        },
        "catchRate": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 255
        },
        "baseFriendship": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 255
        },
        "baseExp": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "Not yet populated for every entry"
        },
        "growthRate": {
            "type": ["string", "null"],
            "enum": ["Slow", "Medium Slow", "Medium Fast", "Fast", "Fluctuating", "Erratic", "", null]
        },
        "eggCycles": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "0 for a small number of recently-added entries pending data collection"
        },
        "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9,
            "description": "Not yet populated for every entry"
        },
        "nameOrigin": {
            "type": "object",
            "description": "Free-form word-fragment -> meaning map, e.g. { \"bulb\": \"a type of plant\" }",
            "additionalProperties": { "type": "string" }
        },
        "pokedexEntries": {
            "type": "object",
            "description": "Keyed by display name (base form and, for entries covering a regional form in the same file, the form's display name)",
            "additionalProperties": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": ["game", "desc"],
                    "additionalProperties": false,
                    "properties": {
                        "game": { "type": "string", "minLength": 1 },
                        "desc": { "type": "string", "minLength": 1 }
                    }
                }
            }
        },
        "moves": {
            "type": "object",
            "description": "Populated at upsert time by pokedex/helpers.js addMovesToPokemon; keyed by game slug"
        },
        "gameDropDown": {
            "type": "array",
            "description": "Populated at upsert time by pokedex/helpers.js createGameDropDown",
            "items": {
                "type": "object",
                "required": ["key", "title"],
                "additionalProperties": false,
                "properties": {
                    "key": { "type": "string" },
                    "title": { "type": "string" }
                }
            }
        }
    }
}
