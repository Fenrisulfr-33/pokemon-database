{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://pokemon-database.com/schemas/move.json",
    "title": "Pokemon Move",
    "description": "Schema for Pokemon move data validation",
    "type": "object",
    "required": [
        "_id",
        "key",
        "name",
        "type",
        "category",
        "contest",
        "pp",
        "power",
        "accuracy",
        "contact",
        "generation",
        "priority",
        "target",
        "meta",
        "changes",
        "effectChanges",
        "flavorText",
        "effect"
    ],
    "properties": {
        "_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Unique move ID"
        },
        "key": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "URL-safe key identifier"
        },
        "name": {
            "type": "object",
            "required": ["english"],
            "description": "Move name keyed by language (pokeApi/pokeApiFormat.js)",
            "propertyNames": { "pattern": "^[a-z0-9-]+$" },
            "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "type": { "$ref": "#/definitions/type" },
        "category": {
            "type": "string",
            "enum": ["physical", "special", "status"]
        },
        "contest": {
            "type": ["string", "null"],
            "enum": ["cool", "beauty", "cute", "smart", "tough", null]
        },
        "pp": { "$ref": "#/definitions/pp" },
        "power": { "$ref": "#/definitions/power" },
        "accuracy": { "$ref": "#/definitions/accuracy" },
        "contact": {
            "type": "boolean",
            "description": "true for the moves listed in moves/CONTACT.md"
        },
        "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
        },
        "priority": {
            "type": "integer",
            "minimum": -7,
            "maximum": 5
        },
        "target": {
            "type": "string",
            "enum": [
                "specific-move",
                "selected-pokemon-me-first",
                "ally",
                "users-field",
                "user-or-ally",
                "opponents-field",
                "user",
                "random-opponent",
                "all-other-pokemon",
                "selected-pokemon",
                "all-opponents",
                "entire-field",
                "user-and-allies",
                "all-pokemon",
                "all-allies",
                "fainting-pokemon"
            ]
        },
        "meta": {
            "oneOf": [{ "$ref": "#/definitions/meta" }, { "type": "null" }],
            "description": "PokeAPI meta; null when PokeAPI has none"
        },
        "changes": {
            "type": "object",
            "description": "Values the move had before each game key",
            "additionalProperties": false,
            "patternProperties": {
                "^[a-z0-9-]+$": { "$ref": "#/definitions/change" }
            }
        },
        "effectChanges": {
            "$ref": "#/definitions/textByLanguageAndGame",
            "description": "Older effect text, keyed by language, then game key (constants/GAME_KEYS.js)"
        },
        "flavorText": {
            "$ref": "#/definitions/textByLanguageAndGame",
            "description": "In-game move text, keyed by language, then game key (constants/GAME_KEYS.js)"
        },
        "effect": { "$ref": "#/definitions/effect" }
    },
    "definitions": {
        "type": {
            "type": "string",
            "enum": [
                "normal",
                "fire",
                "water",
                "electric",
                "grass",
                "ice",
                "fighting",
                "poison",
                "ground",
                "flying",
                "psychic",
                "bug",
                "rock",
                "ghost",
                "dragon",
                "dark",
                "steel",
                "fairy"
            ]
        },
        "pp": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
        },
        "power": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 255
        },
        "accuracy": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 100
        },
        "percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
        },
        "nullableCount": {
            "type": ["integer", "null"],
            "minimum": 1
        },
        "effect": {
            "type": "object",
            "required": ["full", "shortEffect"],
            "additionalProperties": false,
            "properties": {
                "full": { "type": "string" },
                "shortEffect": { "type": "string" }
            }
        },
        "meta": {
            "type": "object",
            "required": [
                "category",
                "ailment",
                "minHits",
                "maxHits",
                "minTurns",
                "maxTurns",
                "drain",
                "healing",
                "critRate",
                "ailmentChance",
                "flinchChance",
                "statChance"
            ],
            "additionalProperties": false,
            "properties": {
                "category": {
                    "type": "string",
                    "enum": [
                        "damage",
                        "ailment",
                        "net-good-stats",
                        "heal",
                        "damage-ailment",
                        "swagger",
                        "damage-lower",
                        "damage-raise",
                        "damage-heal",
                        "ohko",
                        "whole-field-effect",
                        "field-effect",
                        "force-switch",
                        "unique"
                    ]
                },
                "ailment": {
                    "type": "string",
                    "pattern": "^[a-z-]+$"
                },
                "minHits": { "$ref": "#/definitions/nullableCount" },
                "maxHits": { "$ref": "#/definitions/nullableCount" },
                "minTurns": { "$ref": "#/definitions/nullableCount" },
                "maxTurns": { "$ref": "#/definitions/nullableCount" },
                "drain": {
                    "type": "integer",
                    "minimum": -100,
                    "maximum": 100,
                    "description": "% of damage dealt; negative is recoil"
                },
                "healing": {
                    "type": "integer",
                    "minimum": -100,
                    "maximum": 100,
                    "description": "% of max HP; negative is HP lost"
                },
                "critRate": { "type": "integer", "minimum": 0 },
                "ailmentChance": { "$ref": "#/definitions/percent" },
                "flinchChance": { "$ref": "#/definitions/percent" },
                "statChance": { "$ref": "#/definitions/percent" }
            }
        },
        "change": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
                "accuracy": { "$ref": "#/definitions/accuracy" },
                "power": { "$ref": "#/definitions/power" },
                "pp": { "$ref": "#/definitions/pp" },
                "effectChance": { "$ref": "#/definitions/percent" },
                "type": {
                    "anyOf": [
                        { "$ref": "#/definitions/type" },
                        { "const": "unknown" }
                    ],
                    "description": "unknown is the ??? type (Curse before bw)"
                },
                "effect": { "$ref": "#/definitions/effect" }
            }
        },
        "textByLanguageAndGame": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
                "^[a-z0-9-]+$": {
                    "type": "object",
                    "additionalProperties": false,
                    "patternProperties": {
                        "^[a-z0-9-]+$": { "type": "string", "minLength": 1 }
                    }
                }
            }
        }
    },
    "additionalProperties": false
}
