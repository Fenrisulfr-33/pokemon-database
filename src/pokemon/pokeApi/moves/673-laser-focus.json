    "flavor_text_entries": [
        {
            "language": "ja-hrkt",
            "flavor_text": "せいしんを　しゅうちゅうして\nつぎの　こうげきを　かならず\nきゅうしょに　あてる。"
        },
        {
            "language": "ko",
            "flavor_text": "정신을 집중해서\n다음 공격을 반드시\n급소에 맞춘다."
        },
        {
            "language": "zh-hant",
            "flavor_text": "集中精神，\n下次攻擊必定會擊中要害。"
        },
        {
            "language": "fr",
            "flavor_text": "Le lanceur se concentre pour être sûr de porter\nun coup critique au tour suivant."
        },
