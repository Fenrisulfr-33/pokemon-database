    "effect_entries": [
        {
            "language": "fr",
            "effect": "Le lanceur s'endort et regagne immédiatement tous ses PV.  Si le lanceur a un autre effet majeur de statut, le sommeil le remplacera.  Le lanceur se réveille toujours après deux tours, ou un tour avec Matinal.\n\nCette capacité échoue si le Pokémon ne peut pas s'endormir à cause de Brouhaha, Insomnia, ou Esprit Vital.  Elle échoue aussi si le Pokémon a tous ses PV ou est déjà endormi.",
            "short_effect": "Le lanceur dort pendant deux tours, se soignant complètement"
        },
        {
            "language": "en",
            "effect": "User falls to sleep and immediately regains all its HP.  If the user has another major status effect, sleep will replace it.  The user will always wake up after two turns, or one turn with Early Bird.\n\nThis move fails if the Pokémon cannot fall asleep due to Uproar, Insomnia, or Vital Spirit.  It also fails if the Pokémon is at full health or is already asleep.",
            "short_effect": "User sleeps for two turns, completely healing itself."
        }
    ],
    "effect_changes": [
        {
            "game": "diamond-pearl",
            "effect_entries": [
                {
                    "language": "fr",
                    "effect": "Fonctionne pendant le sommeil grâce à Blabla Dodo si les PV ne sont pas au maximum."
                },
                {
                    "language": "en",
                    "effect": "Works while asleep through Sleep Talk if not at full health."
                }
            ]
        }
    ],
