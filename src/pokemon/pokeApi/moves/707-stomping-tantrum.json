    "effect_entries": [
        {
            "language": "fr",
            "effect": "Inflige des dégâts réguliers. La puissance est doublée si la dernière capacité du lanceur a échoué pour n'importe quelle raison (i.e., a produit le message \"Mais cela échoue.\") ou était inefficace dû aux types.",
            "short_effect": "A une puissance double si la dernière capacité du lanceur a échoué."
        },
        {
            "language": "en",
            "effect": "Inflicts regular damage.  Power is doubled if the user’s last move failed for any reason (i.e., produced the message \"But it failed!\") or was ineffective due to types.",
            "short_effect": "Has double power if the user’s last move failed."
        }
    ],
    "effect_changes": [],
    "flavor_text_entries": [
        {
            "language": "ja-hrkt",
            "flavor_text": "くやしさを　バネにして　こうげきする。\nまえの　ターンに　わざを　はずしていると\nいりょくが　ばいに　なる。"
        },
        {
            "language": "ko",
            "flavor_text": "분함을 발판삼아 공격한다.\n앞 턴에서 기술이 빗나갔다면\n위력이 배가 된다."
        },
        {
            "language": "zh-hant",
            "flavor_text": "化悔恨為力量進行攻擊。\n如果上一回合的招式沒有命中，\n威力就會加倍。"
        },
        {
            "language": "fr",
            "flavor_text": "Le lanceur attaque en utilisant sa frustration. S’il a\nutilisé une capacité qui a échoué au tour précédent,\nla puissance de Trépignement est doublée."
        },
        {
            "language": "de",
            "flavor_text": "Von Frust getrieben greift der Anwender an. Wenn\nseine vorige Attacke fehlgeschlagen ist, verdoppelt\nsich die Stärke der Attacke."
        },
        {
            "language": "es",
            "flavor_text": "Usa la frustración como revulsivo para atacar. La\npotencia de Pataleta se duplica si el usuario ha\nfallado el último movimiento usado."
        },
        {
            "language": "it",
            "flavor_text": "Chi la usa attacca battendo i piedi per la rabbia.\nSe la mossa usata al turno precedente non è\nandata a segno, la potenza raddoppia."
        },
        {
            "language": "en",
            "flavor_text": "Driven by frustration, the user attacks the target. If\nthe user’s previous move has failed, the power of\nthis move doubles."
        },
