    "effect_entries": [
        {
            "language": "fr",
            "effect": "Inflige des dégâts réguliers.  Le lanceur change pendant un tour avant d'attaquer.\n\nSous Zénith, le tour de chargement est passé.\n\nSous Grêle, Danse Pluie, ou Tempête de Sable, la puissance est divisée par deux.\n\nCette capacité ne peut pas être sélectionnée par Blabla Dodo.",
            "short_effect": "Requiert un tour de charge avant d'attaquer."
        },
        {
            "language": "en",
            "effect": "Inflicts regular damage.  User charges for one turn before attacking.\n\nDuring Sunny Day, the charge turn is skipped.\n\nDuring Hail, Rain Dance, or Sandstorm, power is halved.\n\nThis move cannot be selected by Sleep Talk.",
            "short_effect": "Requires a turn to charge before attacking."
        }
    ],
